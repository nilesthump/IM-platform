15: ROOT = pathlib.Path(__file__).resolve().parent
16: MIGRATIONS = ROOT / "migrations"
17: VERSION = "0001_initial"
18: LOCK = 481233001
19: 
20: 
21: def psql(sql: str, *, capture: bool = False) -> str:
22:     proc = subprocess.run(
23:         ["psql", "-X", "-v", "ON_ERROR_STOP=1", "-q", "-A", "-t"],
24:         input=sql, text=True, capture_output=True,
25:     )
26:     if proc.returncode:
27:         raise RuntimeError(proc.stderr.strip() or f"psql exited {proc.returncode}")
28:     if not capture and proc.stdout.strip():
29:         print(proc.stdout.strip())
30:     return proc.stdout.strip()
31: 
32: 
33: def migration_sql(direction: str) -> str:
34:     return (MIGRATIONS / f"{VERSION}.{direction}.sql").read_text(encoding="utf-8")
35: 
36: 
37: def checksum() -> str:
38:     return hashlib.sha256(migration_sql("up").encode("utf-8")).hexdigest()
39: 
40: 
41: def applied() -> str | None:
42:     result = psql("SELECT to_regclass('schema_migrations') IS NOT NULL;", capture=True)

