+        try:
+            compose('config', '--quiet')
+            compose('up', '-d', '--build')
+            tls_id = compose('ps', '-q', 'tls-go').decode().strip()
+            require(bool(tls_id), 'TLS role missing')
+            ca = Path(temp) / 'root.crt'
