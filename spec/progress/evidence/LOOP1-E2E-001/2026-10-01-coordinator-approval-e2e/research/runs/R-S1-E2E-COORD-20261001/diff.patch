+        print('PASS cleanup: inspected owned Compose containers/volumes removed', flush=True)
+
+    with tempfile.TemporaryDirectory(prefix='im-s1-e2e-') as temp:
+        config = Path(temp) / 'config'
+        config.mkdir()
+        env['IM_GO_CONFIG_DIR'] = str(config)
