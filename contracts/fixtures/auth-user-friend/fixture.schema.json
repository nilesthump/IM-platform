{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Auth/User/Friend golden fixture collection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixtureVersion",
    "contractVersion",
    "profiles",
    "polarity",
    "scenarios"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "fixtureVersion": {
      "const": "1.1"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "profiles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "go",
          "java"
        ]
      }
    },
    "polarity": {
      "enum": [
        "positive",
        "negative"
      ]
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rules",
          "preconditions",
          "steps",
          "stateAssertions",
          "forbiddenObservations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^AUF-[DIA]-[0-9]{3}$"
            }
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "request",
                "expected"
              ],
              "properties": {
                "request": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "method",
                    "path"
                  ],
                  "properties": {
                    "method": {
                      "enum": [
                        "GET",
                        "POST",
                        "PUT"
                      ]
                    },
                    "path": {
                      "type": "string",
                      "pattern": "^/v1/"
                    },
                    "headers": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "Authorization": {
                          "type": "string"
                        },
                        "Cookie": {
                          "type": "string"
                        }
                      }
                    },
                    "query": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "username": {
                          "type": "string"
                        },
                        "access_token": {
                          "type": "string"
                        }
                      }
                    },
                    "body": {
                      "$ref": "#/definitions/requestBody"
                    }
                  }
                },
                "expected": {
                  "$ref": "#/definitions/expected"
                }
              }
            }
          },
          "stateAssertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbiddenObservations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "definitions": {
    "publicUser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "username",
        "displayName"
      ],
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "username": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        }
      }
    },
    "userResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user"
      ],
      "properties": {
        "user": {
          "$ref": "#/definitions/publicUser"
        }
      }
    },
    "searchResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "users"
      ],
      "properties": {
        "users": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/definitions/publicUser"
          }
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "userId",
        "clientType",
        "sessionEpoch",
        "status"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "userId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "clientType": {
          "enum": [
            "WEB",
            "DESKTOP",
            "MOBILE"
          ]
        },
        "sessionEpoch": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "ACTIVE",
            "REVOKED"
          ]
        }
      }
    },
    "webTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accessToken",
        "accessTokenExpiresInSeconds",
        "refreshTokenDelivery"
      ],
      "properties": {
        "accessToken": {
          "type": "string",
          "minLength": 1
        },
        "accessTokenExpiresInSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "refreshTokenDelivery": {
          "const": "HTTP_ONLY_SECURE_COOKIE"
        }
      }
    },
    "nativeTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accessToken",
        "accessTokenExpiresInSeconds",
        "refreshToken",
        "refreshTokenExpiresInSeconds",
        "refreshTokenDelivery"
      ],
      "properties": {
        "accessToken": {
          "type": "string",
          "minLength": 1
        },
        "accessTokenExpiresInSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "refreshToken": {
          "type": "string",
          "minLength": 1
        },
        "refreshTokenExpiresInSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "refreshTokenDelivery": {
          "const": "RESPONSE_BODY_FOR_OS_SECURE_STORAGE"
        }
      }
    },
    "authResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "tokens",
        "replacedExistingSession"
      ],
      "properties": {
        "session": {
          "$ref": "#/definitions/session"
        },
        "tokens": {
          "oneOf": [
            {
              "$ref": "#/definitions/webTokens"
            },
            {
              "$ref": "#/definitions/nativeTokens"
            }
          ]
        },
        "replacedExistingSession": {
          "type": "boolean"
        }
      }
    },
    "friendshipResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "friendshipId",
        "normalizedPair",
        "directConversationId",
        "memberUserIds",
        "created"
      ],
      "properties": {
        "friendshipId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "normalizedPair": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lowUserId",
            "highUserId"
          ],
          "properties": {
            "lowUserId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "highUserId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          }
        },
        "directConversationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "memberUserIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "created": {
          "type": "boolean"
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "requestId"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "violations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "reason"
                ],
                "properties": {
                  "field": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "responseBody": {
      "oneOf": [
        {
          "$ref": "#/definitions/userResponse"
        },
        {
          "$ref": "#/definitions/searchResponse"
        },
        {
          "$ref": "#/definitions/authResult"
        },
        {
          "$ref": "#/definitions/friendshipResult"
        },
        {
          "$ref": "#/definitions/errorResponse"
        }
      ]
    },
    "requestBody": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "clientType": {
          "type": "string"
        },
        "deviceId": {
          "type": "string"
        },
        "clientVersion": {
          "type": "string"
        },
        "protocolVersion": {
          "type": "string"
        },
        "refreshToken": {
          "type": "string"
        }
      }
    },
    "expectedHeaders": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Set-Cookie": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "normalizedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 200,
          "maximum": 499
        },
        "errorCode": {
          "type": "string"
        },
        "headers": {
          "$ref": "#/definitions/expectedHeaders"
        },
        "body": {
          "$ref": "#/definitions/responseBody"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "normalizedOutputs"
      ],
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 200,
          "maximum": 499
        },
        "errorCode": {
          "type": "string"
        },
        "headers": {
          "$ref": "#/definitions/expectedHeaders"
        },
        "body": {
          "$ref": "#/definitions/responseBody"
        },
        "normalizedOutputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "go",
            "java"
          ],
          "properties": {
            "go": {
              "$ref": "#/definitions/normalizedOutput"
            },
            "java": {
              "$ref": "#/definitions/normalizedOutput"
            }
          }
        }
      }
    }
  }
}
