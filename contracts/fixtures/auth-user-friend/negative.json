{
  "$schema": "./fixture.schema.json",
  "fixtureVersion": "1.0",
  "contractVersion": "1.0.0",
  "profiles": ["go", "java"],
  "polarity": "negative",
  "scenarios": [
    { "id": "invalid-credentials", "rules": ["AUF-D-009", "AUF-I-007"], "preconditions": ["alice exists"], "steps": [{ "request": { "method": "POST", "path": "/v1/auth/login", "body": { "username": "alice", "password": "wrong-password-value", "clientType": "WEB", "deviceId": "browser-1", "clientVersion": "1.0.0", "protocolVersion": "1" } }, "expected": { "status": 401, "errorCode": "AUTH_INVALID_CREDENTIALS" } }], "stateAssertions": ["no session is created"], "forbiddenObservations": ["password or token appears in response logs or traces"] },
    { "id": "token-in-query-rejected", "rules": ["AUF-D-009", "AUF-I-007", "AUF-A-007"], "preconditions": [], "steps": [{ "request": { "method": "GET", "path": "/v1/users/me?access_token=forbidden" }, "expected": { "status": 400, "errorCode": "VALIDATION_FAILED" } }], "stateAssertions": ["request is rejected before authentication"], "forbiddenObservations": ["query credential is logged or traced"] },
    { "id": "invalid-client-type", "rules": ["AUF-D-001", "AUF-I-001"], "preconditions": ["alice exists"], "steps": [{ "request": { "method": "POST", "path": "/v1/auth/login", "body": { "username": "alice", "password": "fixture-password-not-a-real-secret", "clientType": "TABLET", "deviceId": "tablet-1", "clientVersion": "1.0.0", "protocolVersion": "1" } }, "expected": { "status": 400, "errorCode": "VALIDATION_FAILED" } }], "stateAssertions": ["no fourth login slot is representable"], "forbiddenObservations": ["TABLET session created"] },
    { "id": "refresh-client-type-mismatch", "rules": ["AUF-D-001", "AUF-I-002"], "preconditions": ["refresh token belongs to alice WEB epoch 2"], "steps": [{ "request": { "method": "POST", "path": "/v1/auth/refresh", "body": { "refreshToken": "<web-refresh-token>", "clientType": "MOBILE", "clientVersion": "1.0.0", "protocolVersion": "1" } }, "expected": { "status": 401, "errorCode": "AUTH_CLIENT_TYPE_MISMATCH" } }], "stateAssertions": ["no token is issued and WEB remains unchanged"], "forbiddenObservations": ["credential crosses clientType slots"] },
    { "id": "unsupported-protocol-version", "rules": ["AUF-A-008"], "preconditions": ["server supports protocol version 1"], "steps": [{ "request": { "method": "POST", "path": "/v1/auth/login", "body": { "username": "alice", "password": "fixture-password-not-a-real-secret", "clientType": "DESKTOP", "deviceId": "desktop-1", "clientVersion": "1.0.0", "protocolVersion": "999" } }, "expected": { "status": 426, "errorCode": "PROTOCOL_VERSION_UNSUPPORTED" } }], "stateAssertions": ["no session is created"], "forbiddenObservations": ["silent version downgrade"] },
    { "id": "missing-authentication", "rules": ["AUF-D-009"], "preconditions": [], "steps": [{ "request": { "method": "GET", "path": "/v1/friends" }, "expected": { "status": 401, "errorCode": "AUTH_REQUIRED" } }], "stateAssertions": ["no user data is disclosed"], "forbiddenObservations": ["friend list returned"] },
    { "id": "authorization-binding-mismatch", "rules": ["AUF-D-004", "AUF-D-009"], "preconditions": ["access token subject is user A", "resolved session binding belongs to user B"], "steps": [{ "request": { "method": "GET", "path": "/v1/users/me", "headers": { "Authorization": "Bearer <mismatched-binding-token>" } }, "expected": { "status": 403, "errorCode": "AUTHORIZATION_DENIED" } }], "stateAssertions": ["no user profile is disclosed"], "forbiddenObservations": ["client-selected identity overrides the authenticated binding"] },
    { "id": "friend-self-rejected", "rules": ["AUF-D-005", "AUF-I-005"], "preconditions": ["authenticated user ID is 10000000-0000-4000-8000-000000000001"], "steps": [{ "request": { "method": "PUT", "path": "/v1/friends/10000000-0000-4000-8000-000000000001", "headers": { "Authorization": "Bearer <user-A-access-token>" } }, "expected": { "status": 422, "errorCode": "FRIEND_SELF_NOT_ALLOWED" } }], "stateAssertions": ["no friendship conversation membership sync event or outbox effect is written"], "forbiddenObservations": ["self friendship"] },
    { "id": "duplicate-friendship-divergence-rejected", "rules": ["AUF-D-005", "AUF-D-006", "AUF-I-005", "AUF-A-004"], "preconditions": ["normalized A/B friendship and DIRECT conversation already exist"], "steps": [{ "request": { "method": "PUT", "path": "/v1/friends/20000000-0000-4000-8000-000000000002", "headers": { "Authorization": "Bearer <user-A-access-token>" } }, "expected": { "status": 200, "body": { "friendshipId": "30000000-0000-4000-8000-000000000003", "directConversationId": "40000000-0000-4000-8000-000000000004", "created": false } } }], "stateAssertions": ["the original canonical relationship is returned unchanged"], "forbiddenObservations": ["second friendship or second DIRECT conversation commits"] },
    { "id": "non-normalized-pair-divergence-rejected", "rules": ["AUF-D-005", "AUF-I-005", "AUF-A-004"], "preconditions": ["normalized A/B friendship exists", "authenticated caller is the high ordered user B"], "steps": [{ "request": { "method": "PUT", "path": "/v1/friends/10000000-0000-4000-8000-000000000001", "headers": { "Authorization": "Bearer <user-B-access-token>" } }, "expected": { "status": 200, "body": { "lowUserId": "10000000-0000-4000-8000-000000000001", "highUserId": "20000000-0000-4000-8000-000000000002", "created": false } } }], "stateAssertions": ["the same ascending normalized pair is returned regardless of caller direction"], "forbiddenObservations": ["non-normalized or ordered duplicate pair commits"] },
    { "id": "stale-session-epoch-rejected", "rules": ["AUF-D-003", "AUF-I-002", "AUF-A-001"], "preconditions": ["WEB slot current epoch is 8", "token carries epoch 7"], "steps": [{ "request": { "method": "GET", "path": "/v1/users/me", "headers": { "Authorization": "Bearer <stale-web-token-epoch-7>" } }, "expected": { "status": 401, "errorCode": "AUTH_SESSION_EPOCH_STALE" } }], "stateAssertions": ["no authenticated request context is created"], "forbiddenObservations": ["old token reconnects or reads data"] },
    { "id": "revoked-refresh-token-rejected", "rules": ["AUF-D-008", "AUF-I-002"], "preconditions": ["refresh token was revoked by rotation or logout"], "steps": [{ "request": { "method": "POST", "path": "/v1/auth/refresh", "body": { "refreshToken": "<revoked-refresh-token>", "clientType": "MOBILE", "clientVersion": "1.0.0", "protocolVersion": "1" } }, "expected": { "status": 401, "errorCode": "AUTH_REFRESH_REVOKED" } }], "stateAssertions": ["no access or refresh token is issued"], "forbiddenObservations": ["revoked credential is restored"] }
  ]
}
