{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "outDir": "dist",
    "jsx": "react",
    "lib": ["ES2022", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "esModuleInterop": true
  },
  "include": [
    "src/storage/**/*.ts",
    "../shared/protocol-sdk/src/storage/**/*.ts",
    "src/application/**/*.ts",
    "../shared/protocol-sdk/src/send/**/*.ts",
    "src/ui/**/*.tsx"
  ]
}
