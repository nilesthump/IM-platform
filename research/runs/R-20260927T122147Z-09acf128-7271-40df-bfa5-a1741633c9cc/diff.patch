+{
+&#x20; "schema\_version": "1.0",
+&#x20; "canonical\_format": "markdown",
+&#x20; "canonical\_path": "spec/architecture/frozen-architecture.md",
+&#x20; "canonical\_sha256": "\<REAL\_MD\_SHA256>",
