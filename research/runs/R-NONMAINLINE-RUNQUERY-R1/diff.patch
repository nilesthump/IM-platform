     p = sub.add_parser("backfill", parents=[common]); p.add_argument("--task-id", required=True)
+    for name in ("list-runs", "run-stats"):
+        p = sub.add_parser(name, parents=[common])
+        for flag in QUERY_FILTERS:
+            p.add_argument("--" + flag.replace("_", "-"))
