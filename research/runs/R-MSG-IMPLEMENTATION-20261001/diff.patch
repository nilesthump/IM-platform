+	}
+	for _, i := range []int{0, 2} {
+		clients[i].SetReadDeadline(time.Now().Add(80 * time.Millisecond))
+		var e envelope
+		if clients[i].ReadJSON(&e) == nil {
+			t.Fatal("origin/unauthorized local user received event")
+		}
+	}
+}
