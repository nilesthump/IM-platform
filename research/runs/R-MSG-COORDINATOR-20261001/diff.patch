+	ws, _, err := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(server.URL, "http"), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ws.Close()
+	var ack envelope
+	if ws.ReadJSON(&ack) != nil || ack.Type != "message.ack" {
+		t.Fatal("ACK not forwarded")
+	}
+	if !<-received {
+		t.Fatal("transport changed identity/frame")
